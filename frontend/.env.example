# =============================================================================
# MarketHub frontend — environment configuration
# =============================================================================
# Copy this file to `.env.local` (personal, git-ignored) and edit the values:
#
#     cp .env.example .env.local
#
# NEXT_PUBLIC_* variables are public: Next.js inlines them into the browser
# bundle at build time. Never put secrets here — anything a user must not see
# belongs on the backend (backend/.env.local).
#
# src/lib/env.js validates these at boot and fails with an actionable error
# when a required value is missing. There are no localhost fallbacks.

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------
# Base URL of the Django API (no trailing slash required).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# Optional — site identity
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=MarketHub
# Public origin of this site (canonical + OpenGraph tags, Phase 26).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Optional — feature flags
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_SEARCH=true
# Phone/email two-factor auth is not implemented yet (Phase 7/8); keep false
# until it exists.
NEXT_PUBLIC_ENABLE_2FA=false

# -----------------------------------------------------------------------------
# Optional — media (Phase 14)
# -----------------------------------------------------------------------------
# Comma-separated origins of the media bucket/CDN (MinIO, Cloudflare R2, S3 +
# CDN). The API origin is always allowed; everything else is rendered with a
# plain <img> instead of going through the image optimiser.
#   NEXT_PUBLIC_MEDIA_HOSTS=https://cdn.example.com,https://bucket.r2.dev
NEXT_PUBLIC_MEDIA_HOSTS=
