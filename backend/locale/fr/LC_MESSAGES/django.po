msgstr "Le panier est vide"

msgid "Cart item not found"
msgstr "Article du panier introuvable"

msgid "Some products in your cart are no longer available."
msgstr "Certains produits de votre panier ne sont plus disponibles."

msgid "The price of one or more items in your cart has changed."
msgstr "Le prix d'un ou plusieurs articles de votre panier a changé."

msgid "Shipping address not found"
msgstr "Adresse de livraison introuvable"

msgid "Order not found"
msgstr "Commande introuvable"

msgid "Invalid order status"
msgstr "Statut de commande invalide"

msgid "Payment could not be processed. Nothing was charged and no stock was taken."
msgstr ""
"Le paiement n'a pas pu être traité. Aucun montant n'a été débité et aucun "
"stock n'a été réservé."

# --- payments (apps/payments) --------------------------------------------
msgid "order_id is required"
msgstr "order_id est requis"

msgid "Order has already been paid."
msgstr "La commande a déjà été payée."

msgid "Cannot process payment for cancelled order."
msgstr "Impossible de traiter le paiement d'une commande annulée."

msgid "Payment processing failed. Please try again."
msgstr "Le traitement du paiement a échoué. Veuillez réessayer."

msgid "An unexpected error occurred while processing the payment."
msgstr "Une erreur inattendue s'est produite lors du traitement du paiement."

msgid "Order payment was not successful, cannot refund"
msgstr "Le paiement de la commande a échoué, remboursement impossible"

msgid "Cannot refund delivered orders. Please contact support."
msgstr "Impossible de rembourser une commande livrée. Veuillez contacter le support."

msgid "No successful transaction found for this order"
msgstr "Aucune transaction réussie trouvée pour cette commande"

msgid "Refund processing failed. Please contact support."
msgstr "Le traitement du remboursement a échoué. Veuillez contacter le support."

# --- idempotency (core/idempotency.py) -----------------------------------
msgid "Idempotency-Key must be 1-64 characters of [A-Za-z0-9-._]."
msgstr ""
"La clé d'idempotence doit comporter de 1 à 64 caractères parmi "
"[A-Za-z0-9-._]."

msgid "This Idempotency-Key was already used with a different payload."
msgstr "Cette clé d'idempotence a déjà été utilisée avec un contenu différent."

# --- Phase 11: Algeria localisation (apps/users/email.py, otp.py,
# serializers.py; core/i18n.py choice labels) ----------------------------
msgid "Verify your MarketHub account"
msgstr "Vérifiez votre compte MarketHub"

msgid ""
"Hello {name},\n"
"\n"
"Please confirm your email address to activate your MarketHub account:\n"
"{link}\n"
"\n"
"The link expires in 24 hours. If you did not create this account, you can "
"ignore this message."
msgstr ""
"Bonjour {name},\n"
"\n"
"Veuillez confirmer votre adresse e-mail pour activer votre compte MarketHub :\n"
"{link}\n"
"\n"
"Le lien expire dans 24 heures. Si vous n'avez pas créé ce compte, vous "
"pouvez ignorer ce message."

msgid "Reset your MarketHub password"
msgstr "Réinitialisez votre mot de passe MarketHub"

msgid ""
"Hello {name},\n"
"\n"
"Someone asked to reset the password of your MarketHub account:\n"
"{link}\n"
"\n"
"Choose a new password within 24 hours — the link stops working after that, "
"and also as soon as the password changes. If this was not you, ignore this "
"message and nothing changes."
msgstr ""
"Bonjour {name},\n"
"\n"
"Une demande de réinitialisation du mot de passe de votre compte MarketHub a été faite :\n"
"{link}\n"
"\n"
"Choisissez un nouveau mot de passe dans les 24 heures — le lien cesse ensuite de "
"fonctionner, dès que le mot de passe est modifié. Si ce n'est pas vous, ignorez "
"ce message : rien ne change."

msgid "Your MarketHub password was changed"
msgstr "Votre mot de passe MarketHub a été modifié"

msgid ""
"Hello,\n"
"\n"
"The password of your MarketHub account was just changed. If this was not "
"you, reset your password immediately and contact support@markethub.example."
msgstr ""
"Bonjour,\n"
"\n"
"Le mot de passe de votre compte MarketHub vient d'être modifié. Si ce n'est "
"pas vous, réinitialisez-le immédiatement et contactez support@markethub.example."

msgid "Your MarketHub code is {code}. It expires in {minutes} minutes. Never share it."
msgstr "Votre code MarketHub est {code}. Il expire dans {minutes} minutes. Ne le partagez jamais."

msgid "Your MarketHub password was changed."
msgstr "Votre mot de passe MarketHub a été modifié."

msgid "Wilaya not found."
msgstr "Wilaya introuvable."

msgid "Commune not found in this wilaya."
msgstr "Commune introuvable dans cette wilaya."

