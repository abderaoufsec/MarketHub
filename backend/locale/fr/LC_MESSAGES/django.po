# French translations for the MarketHub API error catalogue.
#
# Every msgid here is a literal message raised by the backend: the envelope's
# own sentences (core/exceptions.py, core/middleware.py) plus one entry per
# error the apps raise. Message *codes* are deliberately not translated —
# clients branch on those.
#
# Compiled to .mo with `python manage.py compile_api_messages` (a bundled
# pure-Python writer: GNU msgfmt is not assumed to exist). The committed .mo
# must stay in sync; tests/test_locale.py fails if it does not.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: fr\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

# --- the envelope itself (core/exceptions.py, core/middleware.py) ---------
msgid "Some of the submitted values are invalid."
msgstr "Certaines des valeurs envoyées sont invalides."

msgid "The request could not be processed."
msgstr "La requête n'a pas pu être traitée."

msgid "The request could not be processed. Please try again."
msgstr "La requête n'a pas pu être traitée. Veuillez réessayer."

msgid "Not found."
msgstr "Introuvable."

msgid "Method not allowed."
msgstr "Méthode non autorisée."

msgid "Not acceptable."
msgstr "Non acceptable."

msgid "Conflict."
msgstr "Conflit."

msgid "Unsupported media type."
msgstr "Type de média non pris en charge."

msgid "Too many requests. Try again later."
msgstr "Trop de requêtes. Réessayez plus tard."

msgid "An unexpected error occurred. Please try again."
msgstr "Une erreur inattendue s'est produite. Veuillez réessayer."

msgid "An upstream service is unavailable. Try again shortly."
msgstr "Un service amont est indisponible. Réessayez dans un instant."

msgid "The service is temporarily unavailable. Try again shortly."
msgstr "Le service est temporairement indisponible. Réessayez dans un instant."

msgid "API version not found."
msgstr "Version de l'API introuvable."

msgid "Permission denied."
msgstr "Permission refusée."

# --- stock DRF sentences the envelope re-renders --------------------------
msgid "A server error occurred."
msgstr "Une erreur serveur s'est produite."

msgid "Authentication credentials were not provided."
msgstr "Les identifiants d'authentification sont absents."

msgid "Incorrect authentication credentials."
msgstr "Les identifiants d'authentification sont incorrects."

msgid "You do not have permission to perform this action."
msgstr "Vous n'avez pas la permission d'effectuer cette action."

msgid "Request was throttled."
msgstr "La requête a été limitée."

msgid "Invalid input."
msgstr "Saisie invalide."

msgid "Malformed requests."
msgstr "Requêtes mal formées."

