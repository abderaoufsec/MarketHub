# --- social sign-in (apps/users) -----------------------------------------
msgid "Missing social sign-in token."
msgstr "Jeton de connexion sociale manquant."

msgid "That sign-in token is invalid or expired."
msgstr "Ce jeton de connexion est invalide ou expiré."

msgid "Social provider refused the request."
msgstr "Le fournisseur de connexion a refusé la requête."

msgid "The social provider sent an invalid response."
msgstr "Le fournisseur de connexion a envoyé une réponse invalide."

msgid "Could not reach the social provider."
msgstr "Impossible de joindre le fournisseur de connexion."

msgid "Unsupported social provider."
msgstr "Fournisseur de connexion non pris en charge."

msgid "Google sign-in is not configured."
msgstr "La connexion Google n'est pas configurée."

msgid "That sign-in token was issued for another application."
msgstr "Ce jeton de connexion a été émis pour une autre application."

msgid "That sign-in token was not issued by Google."
msgstr "Ce jeton de connexion n'a pas été émis par Google."

msgid "Your Google account email address is not verified."
msgstr "L'adresse e-mail de votre compte Google n'est pas vérifiée."

msgid "Your Google account has no email address."
msgstr "Votre compte Google n'a pas d'adresse e-mail."

msgid "Facebook sign-in is not configured."
msgstr "La connexion Facebook n'est pas configurée."

msgid "This Facebook account has no email address. Sign up with your phone number instead."
msgstr ""
"Ce compte Facebook n'a pas d'adresse e-mail. Inscrivez-vous avec votre "
"numéro de téléphone."

