# =============================================================================
# MarketHub backend — environment configuration
# =============================================================================
# Copy this file to `.env.local` (personal, git-ignored) and edit the values:
#
#     cp .env.example .env.local
#
# Precedence:  process environment  >  .env.local  >  .env  >  built-in default
#
# Settings live in `backend/core/settings.py` (python-decouple). With
# DEBUG=False the app refuses to start until DJANGO_SECRET_KEY and DB_PASSWORD
# are set to real values, so production cannot boot on these placeholders.
#
# Generate a real secret key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# -----------------------------------------------------------------------------
# Core Django
# -----------------------------------------------------------------------------
# REQUIRED in production (>= 32 chars, unique per environment). Placeholders
# containing "insecure"/"change"/"example" are rejected when DEBUG=False.
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production

# False is the default and MUST stay False in production.
DEBUG=True

# Comma-separated hosts. Add your domain in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Logging (root / django / apps loggers)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
APPS_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_NAME=markethub
DB_USER=postgres
# REQUIRED in production — no default is baked into the code anymore.
DB_PASSWORD=12345
DB_HOST=localhost
DB_PORT=5432
# Persistent connections per worker; 0 disables pooling (safe default).
DB_CONN_MAX_AGE=0

# -----------------------------------------------------------------------------
# CORS (frontend origins allowed to call the API)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Response headers a cross-origin browser client is allowed to read: the
# Phase 9 contract (correlation id, throttle hint, API version, replay flag).
#CORS_EXPOSE_HEADERS=X-Request-ID, Retry-After, X-API-Version, Idempotency-Replayed, Location

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# Development default: django.core.mail.backends.console.EmailBackend
# Production: set django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=noreply@markethub.com
EMAIL_TIMEOUT=10

# -----------------------------------------------------------------------------
# JWT lifetimes
# -----------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# -----------------------------------------------------------------------------
# Security posture (Phase 7) — every value below defaults correctly for the
# DEBUG value above: DEBUG=True -> dev posture (plain HTTP ok),
# DEBUG=False -> production posture (secure cookies, HSTS, SSL redirect).
# -----------------------------------------------------------------------------
# Origins trusted for Django's Origin/Referer CSRF check. Required for the
# HttpOnly-cookie session because the Next.js app is cross-*origin* (port)
# from the API. Add your production frontend origin here.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SameSite for the HttpOnly JWT cookies. "Lax" covers same-site deployments
# (www + api on one domain). If the frontend is on a *different site* than the
# API (e.g. a Vercel app), set "None" — which also requires AUTH_COOKIE_SECURE.
AUTH_COOKIE_SAMESITE=Lax
# SameSite for Django's own session/CSRF cookies (rarely need changing).
#SESSION_COOKIE_SAMESITE=Lax
#CSRF_COOKIE_SAMESITE=Lax

# Every *_SECURE flag below defaults to False with DEBUG=True and True with
# DEBUG=False; uncomment only to override that (e.g. TLS terminates at a proxy
# that already sets them, or a same-site deployment stays on plain HTTP).
#SECURE_SSL_REDIRECT=True
#SESSION_COOKIE_SECURE=True
#CSRF_COOKIE_SECURE=True
#AUTH_COOKIE_SECURE=True
#SECURE_HSTS_SECONDS=31536000
#SECURE_HSTS_INCLUDE_SUBDOMAINS=True
#SECURE_HSTS_PRELOAD=True
# Referrer header sent to other origins (default: same-origin).
#SECURE_REFERRER_POLICY=same-origin
# Set when TLS terminates at a reverse proxy in front of the app:
#USE_X_FORWARDED_PROTO=True

# -----------------------------------------------------------------------------
# Throttling (Phase 7) — DRF rates, "N/period" (s/m/h/d). Per-scope; only the
# endpoints that opt in are throttled (auth endpoints + phone-reveal views).
# -----------------------------------------------------------------------------
THROTTLE_RATE_LOGIN=10/min
THROTTLE_RATE_REGISTER=10/hour
THROTTLE_RATE_VERIFY_EMAIL=20/hour
THROTTLE_RATE_CHANGE_PASSWORD=5/hour
THROTTLE_RATE_TOKEN_REFRESH=30/min
# Anti-scraping rate for endpoints that expose a phone number.
THROTTLE_RATE_REVEAL_PHONE=30/min
# Phase 8 — OTP request/verify, password recovery, resend, social sign-in.
# Coarse per-IP gates; the per-number/per-IP *daily budgets* that make SMS
# pumping unprofitable are the OTP_* settings below (apps/users/otp.py).
THROTTLE_RATE_OTP_REQUEST=30/hour
THROTTLE_RATE_OTP_VERIFY=30/min
THROTTLE_RATE_FORGOT_PASSWORD=10/hour
THROTTLE_RATE_RESEND_VERIFICATION=10/hour
THROTTLE_RATE_SOCIAL_LOGIN=10/hour

# -----------------------------------------------------------------------------
# SMS / phone OTP (Phase 8) — phone is the primary identity in Algeria.
# -----------------------------------------------------------------------------
# Development default logs the code to the console (mirrors EMAIL_BACKEND).
# Production: apps.users.sms.HttpJsonSmsBackend + the three values below, or a
# custom class implementing apps.users.sms.SmsBackend (WhatsApp/Viber etc.).
SMS_BACKEND=apps.users.sms.ConsoleSmsBackend
SMS_API_URL=
SMS_API_KEY=
SMS_FROM=MarketHub
SMS_TIMEOUT=10

# OTP hardening: 6 digits, 5 minutes, 5 wrong tries, 60s resend cooldown,
# 5 SMS/day/number + 20 SMS/day/IP (SMS pumping defence).
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_DAY=5
OTP_MAX_PER_IP_PER_DAY=20

# -----------------------------------------------------------------------------
# Social login (Phase 8, optional) — blank means the provider answers 503
# "not configured"; every token is verified server-side against the issuer.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
SOCIAL_HTTP_TIMEOUT=10

# -----------------------------------------------------------------------------
# Cache — OTP budgets, login backoff and idempotency replay all live here.
# The locmem default is per-process; in multi-worker production point this at
# Redis: django.core.cache.backends.redis.RedisCache + redis://host:6379/0
# -----------------------------------------------------------------------------
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=markethub

# -----------------------------------------------------------------------------
# Dev tooling
# -----------------------------------------------------------------------------
# django-debug-toolbar's SQL panel (requires DEBUG=True; ignored otherwise, and
# the app starts the same whether or not the package is installed).
#DEBUG_TOOLBAR=1

# -----------------------------------------------------------------------------
# Platform
# -----------------------------------------------------------------------------
# Free-plan listing quota; per-plan quotas are stubbed in apps/users/plans.py
# and become real plans in Phase 21.
MAX_PRODUCTS_PER_SELLER=20
PLATFORM_COMMISSION_RATE=0.15
SITE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Localization (Algeria-ready defaults)
# -----------------------------------------------------------------------------
LANGUAGE_CODE=fr
TIME_ZONE=Africa/Algiers
