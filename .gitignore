# ============================================
# MarketHub — .gitignore
# Python / Django backend + Next.js frontend
# ============================================

# ---------- Secrets & environment ----------
# Keep *.env.example tracked; never commit real env files.
.env
.env.*
!.env.example
!.env*.example
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
ENV/
.envrc

# Distribution / packaging
*.egg-info/
*.egg
dist/
build/
sdist/
wheels/
.eggs/

# Test / coverage caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/
.cache/

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.pytype/

# ---------- Django ----------
# Static collected output (run `manage.py collectstatic` on deploy)
backend/staticfiles/
backend/media/
*.log

# SQLite fallback databases (dev/test only)
*.sqlite3
*.sqlite3-journal
db.sqlite3

# ---------- Node / Next.js ----------
node_modules/
.npm
.yarn/
.pnpm-debug.log*

# Next.js build output
frontend/.next/
out/
next-env.d.ts

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage
coverage/
test-results/
playwright-report/
*.lcov
.nyc_output/

# ---------- Editors & IDEs ----------
.vscode/
.idea/
*.swp
*.swo
*~
.code-workspace
.DS_Store.db
.fleet/

# ---------- OS ----------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.AppleDouble
.LSOverride

# ---------- Project-specific ----------
# Environment-specific overrides
*.local.yaml
*.local.yml
